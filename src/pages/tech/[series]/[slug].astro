---
import { getCollection, render, type CollectionEntry } from "astro:content"
import TechLayout from "$/layouts/tech.astro"
import { getLastSlug } from "$/lib/url"
import { type TechNotComingSoon, isNotDraft } from "$/lib/collection"
import { and, or } from "$/lib/filter"
import { isDev, isPreviewBranch } from "$/lib/environment"

import "$/styles/prose-use-marker.css"

export async function getStaticPaths() {
  const filterSeries = (entry: CollectionEntry<"tech">) => {
    return !!entry.data.series
  }

  const collection = await getCollection("tech", and(filterSeries, or(isDev, isPreviewBranch, isNotDraft)))
  return collection.map((page) => {
    return {
      params: { series: page.data.series!.id, slug: getLastSlug(page.id) },
      props: { page }
    }
  })
}

interface Props {
  page: TechNotComingSoon
}

const { page } = Astro.props
const { slug, series } = Astro.params

const { data } = page
const { meta } = data

const { Content, headings } = await render(page)

const ogimage = `/og/tech/${series}/${slug}.png`
---

<TechLayout entry={page} meta={{ ogimage, ...meta }} headings={headings}>
  <Content />
</TechLayout>
