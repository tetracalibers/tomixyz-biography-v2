---
import DefaultPageLayout from "$/layouts/default.astro"
import { Image } from "astro:assets"
import img_tomixy from "$/assets/profiles/pastel-tomixy_op.png"
import img_color_prism from "$/assets/highlights/color-prism.jpg"
import { marked } from "marked"
import Timeline from "$components/pages/index/Timeline.astro"
import Prose from "$components/prose/Prose.astro"
import TagsList from "$components/pages/index/TagsList.astro"
import Highlight from "$components/pages/index/Highlight.astro"

const title = "tomixy"
const subtitle = "I'm a front-end developer in Japan."

const meta = {
  ogimage: "/og/default.png"
}

const profile = `
  2002年生まれ。
  
  高校時代に独学でプログラミングを始め、高校在学中からWeb開発のクライアントワークを経験。 高校卒業後は、都内のIT企業にてWebエンジニアとプログラミング講師を兼業した。

  次第にアクセシビリティやグラフィック表現に携わりたいという思いが強くなり、フロントエンドエンジニアの道を選ぶ。2022年11月に[株式会社ピクセルグリッド](https://www.pxgrid.com/)に入社。
  
  著書に「[Astro × GitHub × Cloudflareで学ぶモダンWeb開発](https://www.amazon.co.jp/dp/B0F7FH7BB6/)」（共著：KDP）がある。
`

const highlight = `
  色のユニバーサルデザインの視点も備えた、色の専門家を目指して勉強中です。
  その一環として、光と色について学べるサイトを運営しています。

  - [Color Prism](/projects/color-prism/)

  触って動かせるデモやゲーム、穴埋め問題集としても活用できるコンテンツを充実させています。
  また、色彩だけでなく、光や色の理論の延長線上として、CGと画像処理も扱っています。
`

const history = [
  {
    date: "2022-11",
    title: "株式会社ピクセルグリッドに入社",
    details: "以来、AstroやSolid.js、Svelteなどのモダンな技術を中心とした開発に従事。"
  },
  {
    date: "2022-05",
    title: "HTML・CSS・VBA等のプログラミング講習会を主催",
    details: "Zoomによる開催。10~20人の参加者が集まる中、事前に配布した自作教材をベースに実演型の講義を行った。"
  },
  {
    date: "2022-04",
    title: "都内IT企業にて、ECサイト開発プロジェクトをリード",
    details:
      "DB設計・API設計・画面設計を主任。開発面ではVueによる画面構築、フォームバリデーション、Laravelによるチャット機能、認証機構などを担当。フレームワーク使用経験が乏しいメンバーも多かったが、テックリードとして技術指導を行い、戦力として育成した。"
  },
  {
    date: "2022-03",
    title: "高校を卒業",
    details: "NHK学園高等学校を卒業し、上京。"
  },
  {
    date: "2021-05",
    title: "フリーランスとして初案件を受託",
    details: "Twitterでの営業活動から、高校在学中に個人でのクライアントワークを経験することとなった。"
  },
  {
    date: "2021-03",
    title: "Web技術に触れ始める",
    details: "HTML、CSS、JavaScriptと同時にbashも学び始め、よく開発環境構築を自動化するようになった。"
  },
  {
    date: "2021-01",
    title: "プログラミング学習を開始",
    details:
      "次世代LaTeXのコア言語expl3を学び始めるも、挫折。学習教材が豊富なメジャー言語から理解しようと考えたのがはじまり。"
  },
  {
    date: "2020-06",
    title: "LaTeXによる組版とマクロ開発を始める",
    details: "高品質な教材を製作するために組版技術を学び始めたが、徐々にマクロ開発に傾倒。プログラミングに関心を持つ。"
  },
  {
    date: "2020-03",
    title: "Clearnote事務局からのスカウトにより、教材販売活動を開始",
    details:
      "高校2年当時から、学部レベルの数学や物理、有機化学に関心があり、自身の学習のために教材を作成していた。現役の大学生からも好評を得て、[Clearnote](https:--www.clearnotebooks.com-ja-authors-2541851)事務局からのスカウトにより販売活動を開始することになった。"
  }
]
---

<DefaultPageLayout content={{ title, subtitle }} meta={meta}>
  <Prose>
    <div class="section -profile">
      <div class="Image-wrapper">
        <Image src={img_tomixy} alt="tomixy" style="max-width: 80px; opacity: 0.9;" />
      </div>
      <Fragment set:html={marked.parse(profile)} />
    </div>
  </Prose>
  <Prose>
    <div class="section -highlight">
      <h2 class="heading">Highlight</h2>
      <Highlight
        image={img_color_prism}
        alt="Color Prism - 見て・触って学ぶ 色と視覚表現"
        href="https://color-prism.net/"
        body={highlight}
      />
    </div>
  </Prose>
  <Prose>
    <div class="section -skill-tag">
      <h2 class="heading">Skill Tag</h2>
      <TagsList />
    </div>
  </Prose>
  <Prose>
    <div class="section -history">
      <h2 class="heading">History</h2>
      <Timeline items={history} />
    </div>
  </Prose>
</DefaultPageLayout>

<style>
  .section {
    /* 帯として見せたい子要素（TagsList）が負マージンで打ち消せるよう、値を変数で公開する */
    --section-padding-inline: calc(2vw * 2.5);
    padding-inline: var(--section-padding-inline);
  }
  :is(.-highlight, .-history, .-skill-tag) {
    display: grid;
    gap: 2.5rem;
  }
  .Image-wrapper {
    width: fit-content;
    margin-inline: auto;
    margin-block-start: -2rem;
  }
  .heading {
    margin: 0;
  }
</style>
