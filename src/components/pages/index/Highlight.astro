---
import { Image } from "astro:assets"
import { marked } from "marked"
import type { ImageMetadata } from "astro"

interface Props {
  image: ImageMetadata
  alt: string
  href: string
  body: string
}

const { image, alt, href, body } = Astro.props
---

<div class="Highlight">
  <a class="Highlight-image" href={href} target="_blank" rel="noopener noreferrer">
    <Image src={image} alt={alt} />
  </a>
  <div class="Highlight-body">
    <Fragment set:html={marked.parse(body)} />
  </div>
</div>

<style>
  .Highlight {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .Highlight-body :global(:is(p, ul):first-child) {
    margin-block-start: 0;
  }
  .Highlight-body :global(:is(p, ul):last-child) {
    margin-block-end: 0;
  }
  .Highlight-image {
    display: block;
    position: relative;
    font-size: 1rem;
    text-decoration: none;
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .Highlight-image img {
    display: block;
    width: 100%;
    height: auto;
    opacity: 0.9;
  }
  /* global.css の a[target="_blank"]::after を、画像の下ではなく画像内の右上に重ねる */
  .Highlight-image::before,
  .Highlight-image::after {
    position: absolute;
    top: 0.625rem;
    right: 0.625rem;
  }
  .Highlight-image::before {
    content: "";
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 50%;
    background-color: rgb(255 255 255 / 0.75);
  }
  .Highlight-image::after {
    width: 0.9rem;
    height: 0.9rem;
    color: var(--slate-600);
  }
  @media (min-width: 768px) {
    .Highlight {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
</style>
