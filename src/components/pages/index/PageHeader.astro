---
import PageTitle from "./PageTitle.astro"

interface Props {
  title: string
  style?: {
    title_small?: boolean
  }
}

const { title, style } = Astro.props
---

<div class="PageHeader">
  <PageTitle title={title} small={style?.title_small} />
  <div class="subtitle-group">
    <p class="subtitle">
      <slot />
    </p>
    <slot name="after-subtitle" />
  </div>
</div>

<style>
  .PageHeader {
    display: grid;
    text-align: center;
  }
  /* subtitleとafter-subtitleスロットの間隔はこのgapで調整する */
  .subtitle-group {
    display: grid;
    gap: 0.25rem;
  }
  .subtitle {
    margin: 0;
    line-height: 1.7;
    color: light-dark(var(--slate-600), var(--slate-200));
  }

  .subtitle :global(a) {
    color: light-dark(#475569, #e2e8f0);
    text-decoration: underline;
    font-weight: 500;

    text-underline-offset: 0.25rem;
    text-decoration-thickness: 1px;
    text-decoration-style: dotted;
  }
  .subtitle :global(a:hover) {
    color: light-dark(#64748b, #cbd5e1);
  }
</style>
