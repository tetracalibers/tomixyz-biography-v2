---
import { getMonthName } from "$/lib/date"
import { Icon } from "astro-icon/components"

interface Props {
  date: string | Date
}

const { date } = Astro.props

const dateObj = new Date(date)
const year = dateObj.getFullYear().toString()
---

<div class="PublishDate">
  <div class="background"><Icon name="geo:turf-explode" /></div>
  <div class="text">
    <span class="year">{year}</span>
    <span class="month">
      {getMonthName(date)}
    </span>
  </div>
</div>

<style>
  .PublishDate {
    display: grid;
    place-items: center;
    color: light-dark(var(--gray-400), var(--gray-300));
    line-height: 1;
    font-weight: 600;
    position: absolute;
    top: -4rem;
    right: 0.5cqw;
    align-self: start;
    /* 高さは必ず日付テキスト分だけにする。
       親（プレビューのテキスト全体）の高さに伸びると、
       place-items: center によって日付が縦中央へ押し下げられ、
       カードが高いときに説明文と重なってしまう */
  }
  @media (min-width: 499px) {
    .PublishDate {
      position: relative;
      top: -0.5rem;
      right: 0;
    }
  }
  :is(.background, .text) {
    grid-column: 1 / -1;
    grid-row: 1 / -1;
  }
  .text {
    display: grid;
    place-items: center;
    gap: 0.2rem;
    padding: 2rem;
  }
  .year {
    font-size: 1.5rem;
  }
  .month {
    font-size: 1.2rem;
    font-style: italic;
  }

  /* グリッドトラックの寸法に影響させないため、背景アイコンは絶対配置で敷く */
  .background {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  [data-icon] {
    width: 100%;
    height: 100%;
  }
</style>
