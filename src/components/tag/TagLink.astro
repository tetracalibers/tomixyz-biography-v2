---
import { SITE } from "$/config"
import { getEntry } from "astro:content"
import { Icon } from "astro-icon/components"
import { getTagIcon } from "$/lib/tag-icon"

interface Props {
  tagId: string
  small?: boolean
  count?: number
  withIcon?: boolean
}

const { tagId, small, count, withIcon } = Astro.props

const hue = Math.floor(Math.random() * 360) + "deg"
const href = SITE.base + "/tags/" + tagId
const tag = await getEntry("tag", tagId)
const icon = withIcon ? getTagIcon(tagId) : undefined
---

<a href={href} class:list={["Tag", { "-small": small, "-with-icon": withIcon }]}>
  {icon && <Icon name={icon} class="logo" />}
  <span>{tag!.data.name}</span>
  {count && <span class="count">({count})</span>}
</a>

<style define:vars={{ hue, "dark-twinkle-width": small ? "0.5rem" : "1rem" }}>
  .Tag {
    --twinkle-width: 24%;
    /* 狭い画面では、角丸が大きいままだとアイコンが左上のカーブに食い込むため、padding-inlineと連動して縮める */
    --border-radius: clamp(1.125rem, 0.908rem + 0.925vw, 1.5rem);

    display: inline-flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.25em;
    background-image: repeating-linear-gradient(
      225deg,
      rgba(191, 228, 255, 0.1) var(--twinkle-width),
      rgba(234, 239, 242, 0.3) 5%,
      rgba(206, 206, 255, 0.6) 55.07%,
      rgba(223, 209, 249, 0.4) 77%,
      rgba(230, 227, 245, 0.1) 93%,
      rgba(234, 239, 242, 0.1) 100%
    );
    filter: hue-rotate(var(--hue));
    text-decoration: none;
    border-bottom-right-radius: var(--border-radius);
    border-top-left-radius: var(--border-radius);
    font-size: clamp(0.875rem, 0.716rem + 0.678vw, 1.15rem);
    line-height: 1.4;
    padding-inline: clamp(0.875rem, 0.803rem + 0.308vw, 1rem);
    padding-block: 0.25rem;
    font-family: "Ubuntu Mono";
  }

  /* ロゴアイコン付き(トップページのSkill Tag)はライトモードで読みづらくなるため、リンクの既定色のままにする */
  .Tag:not(.-with-icon) {
    color: light-dark(var(--slate-500), white);
  }

  :global(.dark) .Tag {
    --twinkle-width: var(--dark-twinkle-width);
    filter: hue-rotate(var(--hue)) saturate(1.5) contrast(1.2);
    mix-blend-mode: hard-light;
  }

  .-small {
    border-bottom-right-radius: 0.75rem;
    border-top-left-radius: 0.75rem;
    font-size: 1rem;
    line-height: 1.5rem;
    padding-inline: 0.5rem;
    padding-block: 0;
  }

  .count {
    font-size: 0.75em;
    color: light-dark(var(--slate-500), var(--slate-300));
  }

  /* 横長のロゴも一律の枠に収める
     svg内のsymbolがviewBoxを持つため、枠に合わせて縦横比を保ったまま縮小される */
  .logo {
    width: 1.35em;
    height: 1.15em;
    flex-shrink: 0;
    align-self: center;
    /* 親の.Tagにかかっているfilterを打ち消し、ロゴを本来の色で表示する */
    filter: hue-rotate(calc(var(--hue) * -1));
  }

  :global(.dark) .logo {
    filter: contrast(calc(1 / 1.2)) saturate(calc(1 / 1.5)) hue-rotate(calc(var(--hue) * -1));
  }
</style>
